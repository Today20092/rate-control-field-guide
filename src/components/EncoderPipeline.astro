---
/** The four steps every block goes through in H.264 and H.265. A static diagram with a text equivalent. */
const steps = [
  { n: 1, name: 'Predict', note: 'Guess the block from nearby pixels or from another frame.' },
  { n: 2, name: 'Subtract', note: 'Keep only what the guess got wrong: the leftover.' },
  { n: 3, name: 'Round', note: 'Turn the leftover into frequencies and round them (quantize).' },
  { n: 4, name: 'Pack', note: 'Write the few remaining numbers in as few bits as possible.' },
]
---

<ol class="pipeline">
  {steps.map((s) => (
    <li>
      <span class="n label" aria-hidden="true">
        {s.n}
      </span>
      <strong>{s.name}</strong>
      <span class="note">{s.note}</span>
    </li>
  ))}
</ol>

<style>
  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    counter-reset: step;
  }
  @media (min-width: 48rem) {
    .pipeline {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 0.25rem 0 0;
    border-top: 1.5px solid var(--color-ink);
  }
  li:first-child {
    border-top-color: var(--color-motion);
  }
  @media (min-width: 48rem) {
    li:not(:last-child)::after {
      content: '';
      position: absolute;
      right: -0.7rem;
      top: -1.5px;
      width: 0.6rem;
      height: 1.5px;
      background: var(--color-ink);
    }
  }
  .n {
    color: var(--color-ink-faint);
  }
  strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
  }
  .note {
    font-size: var(--text-base);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }
</style>
