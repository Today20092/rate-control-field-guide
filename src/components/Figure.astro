---
/**
 * A figure sheet for diagrams and interactive widgets. `takeaway` is the one-sentence point,
 * always visible as the caption so the meaning never depends on operating the widget.
 */
interface Props {
  takeaway: string
  note?: string // e.g. "Illustrative sizes, not measurements."
}
const { takeaway, note } = Astro.props
---

<figure class="sheet">
  <div class="stage">
    <slot />
  </div>
  <figcaption>
    <span class="point">{takeaway}</span>
    {note && <span class="note label">{note}</span>}
  </figcaption>
</figure>

<style>
  /* A ruled exposure-sheet frame set straight on the paper: heavy rule above, hairline below. */
  .sheet {
    margin: 3rem 0;
    border-top: 1.5px solid var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  .stage {
    padding: 1.5rem 0;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.9rem 0;
    border-top: 1px dashed var(--color-line);
  }
  .point {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.35;
    max-width: 44rem;
  }
  .note {
    color: var(--color-ink-faint);
  }
</style>
