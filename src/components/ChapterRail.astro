---
/**
 * Chapter navigation drawn as an animator's timing chart: one tick per chapter, the current one red.
 * Desktop: a sticky left rail. Phone: a sticky bar with a native disclosure listing the chapters.
 */
import { chapters } from '../content/chapters'
---

<nav aria-label="Chapters" class="rail">
  <ol>
    {chapters.map((c, i) => (
      <li>
        <a href={`#${c.id}`} data-chapter={c.id}>
          <span class="tick" aria-hidden="true" />
          <span class="num">{i + 1}</span>
          <span class="name">{c.short}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<details class="mobile-contents">
  <summary>
    <span class="label">Contents</span>
    <span class="current" data-current-label>
      Start
    </span>
  </summary>
  <ol>
    {chapters.map((c, i) => (
      <li>
        <a href={`#${c.id}`} data-chapter={c.id}>
          <span class="num">{i + 1}</span> {c.title}
        </a>
      </li>
    ))}
  </ol>
</details>

<script>
  import { chapters } from '../content/chapters'

  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-chapter]')
  const label = document.querySelector('[data-current-label]')
  const details = document.querySelector<HTMLDetailsElement>('.mobile-contents')

  function setCurrent(id: string | null) {
    links.forEach((a) => {
      if (a.dataset.chapter === id) a.setAttribute('aria-current', 'location')
      else a.removeAttribute('aria-current')
    })
    const chapter = chapters.find((c) => c.id === id)
    if (label) label.textContent = chapter ? chapter.short : 'Start'
  }

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries.filter((e) => e.isIntersecting)
      if (visible.length) setCurrent(visible[visible.length - 1].target.id)
    },
    { rootMargin: '-40% 0px -55% 0px' },
  )
  chapters.forEach((c) => {
    const el = document.getElementById(c.id)
    if (el) observer.observe(el)
  })
  links.forEach((a) => a.addEventListener('click', () => details?.removeAttribute('open')))
</script>

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }

  .rail {
    display: none;
  }
  @media (min-width: 70rem) {
    .rail {
      display: block;
      position: sticky;
      top: 0;
      height: 100dvh;
      padding: 2.5rem 0 2rem 1.25rem;
      border-right: 1px solid var(--color-line);
    }
    .rail a {
      display: grid;
      grid-template-columns: 1.75rem 1.5rem 1fr;
      align-items: center;
      min-height: 2.75rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-ink-soft);
    }
    .rail .tick {
      height: 1px;
      width: 1.25rem;
      background: var(--color-ink);
      transition:
        height 200ms var(--ease-out-expo),
        width 200ms var(--ease-out-expo);
    }
    .rail .name {
      line-height: 1.25;
      padding-right: 0.75rem;
    }
    .rail a:hover .tick {
      width: 1.6rem;
    }
    .rail a[aria-current] {
      color: var(--color-key-ink);
      font-weight: 700;
    }
    .rail a[aria-current] .tick {
      height: 3px;
      width: 1.6rem;
      background: var(--color-key);
    }
    .mobile-contents {
      display: none;
    }
  }

  .mobile-contents {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0 1rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    margin-left: auto;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--color-ink);
    border-bottom: 2px solid var(--color-ink);
    transform: rotate(45deg) translateY(-2px);
  }
  details[open] summary::after {
    transform: rotate(-135deg);
  }
  .current {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-key-ink);
  }
  .mobile-contents ol {
    padding: 0 1rem 1rem;
  }
  .mobile-contents a {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 2.75rem;
    border-top: 1px solid var(--color-line);
  }
  .mobile-contents a[aria-current] {
    color: var(--color-key-ink);
    font-weight: 700;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
