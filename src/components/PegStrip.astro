---
/** Acme peg holes: the registration strip every animation sheet is punched with. Decorative. */
interface Props {
  size?: 'page' | 'chapter'
}
const { size = 'chapter' } = Astro.props
---

<div class:list={['pegs', size]} aria-hidden="true">
  <i></i>
  <i class="slot"></i>
  <i></i>
</div>

<style>
  .pegs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(3rem, 12vw, 8rem);
    background: var(--color-peg);
  }
  .page {
    height: 3.5rem;
    border-bottom: 1px solid var(--color-peg-shade);
  }
  .chapter {
    height: 2.25rem;
    border-radius: 0.5rem 0.5rem 0 0;
    gap: clamp(2rem, 8vw, 5rem);
  }
  i {
    display: block;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 999px;
    background: var(--color-paper);
    box-shadow: inset 0 2px 0 var(--color-peg-shade);
  }
  .chapter i {
    width: 1rem;
    height: 1rem;
  }
  i.slot {
    width: 4.5rem;
  }
  .chapter i.slot {
    width: 3rem;
  }
</style>
