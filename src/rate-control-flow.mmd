    classDef vbr fill:#7b8cff,stroke:#171819,stroke-width:2px,color:#171819
    classDef crf fill:#ff6b45,stroke:#171819,stroke-width:2px,color:#171819
    classDef cqp fill:#f5b73b,stroke:#171819,stroke-width:2px,color:#171819

    class Start start
    class Live,Size,Quality decision
    class CBR cbr
